# Copy to .env. The defaults below match `docker compose up -d`, so local
# development needs no changes. Every hosted service listed has a free tier
# that needs no credit card.

# ---------------------------------------------------------------------------
# Databases: one per service (never shared).
# Local: the Postgres container. Hosted: Neon, one database per service.
# Neon setup (CLI): create a project, then a database per service, then copy each
# pooled connection string here (they need sslmode=require, which Neon includes):
#   neon projects create --name ordermesh --region-id aws-ap-southeast-1
#   neon databases create --name orders --project-id <id>   # also inventory, payments, notifications
#   neon connection-string --project-id <id> --database-name orders --pooled
# Then run the services against it with docker-compose.neon.yml (see README).
# ---------------------------------------------------------------------------
ORDER_DATABASE_URL="postgresql://ordermesh:ordermesh@localhost:15432/orders"
INVENTORY_DATABASE_URL="postgresql://ordermesh:ordermesh@localhost:15432/inventory"
PAYMENT_DATABASE_URL="postgresql://ordermesh:ordermesh@localhost:15432/payments"
NOTIFICATION_DATABASE_URL="postgresql://ordermesh:ordermesh@localhost:15432/notifications"

# ---------------------------------------------------------------------------
# Kafka
# Local: the Kafka container.
# Aiven free tier (https://aiven.io/free-tier): set the service URI, enable
# SASL in the console, and paste the CA certificate (keep the line breaks as \n
# or set it from a file in your host's dashboard).
# ---------------------------------------------------------------------------
KAFKA_BROKERS="localhost:9092"
# KAFKA_SASL_MECHANISM="scram-sha-256"
# KAFKA_SASL_USERNAME="avnadmin"
# KAFKA_SASL_PASSWORD=""
# KAFKA_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---------------------------------------------------------------------------
# Tracing (OpenTelemetry). Local: Jaeger from docker compose.
# Set OTEL_TRACES_EXPORTER=none to turn tracing off.
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_TRACES_EXPORTER="otlp"
OTEL_METRICS_EXPORTER="none"
OTEL_LOGS_EXPORTER="none"
OTEL_NODE_RESOURCE_DETECTORS="none"

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
LOG_LEVEL="info"
OUTBOX_POLL_INTERVAL_MS="500"
# Share of mock payments that are declined (0 to 1). Raise it to watch the
# saga compensate.
PAYMENT_FAILURE_RATE="0.2"
PAYMENT_LATENCY_MS="150"
