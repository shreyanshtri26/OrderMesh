{
  "name": "ordermesh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-driven order processing with Kafka, the transactional outbox and saga compensation",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./services/*\" dev",
    "start:all": "node scripts/start-all.ts",
    "migrate": "pnpm --filter \"./services/*\" migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/sdk-node": "^0.223.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
