{
  // Type-check only. Services run TypeScript directly with Node's built-in
  // type stripping (Node >= 22.18), so there is no build step and no dist/.
  // That requires erasable syntax only: no enums, namespaces or parameter
  // properties, and relative imports that end in ".ts".
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "services/*/src",
    "services/*/test",
    "scripts",
    "test",
    "vitest.config.ts"
  ]
}
